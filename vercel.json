{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,

  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",

  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],

  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{historico-*.html,server/data/*.json,server/agente.ps1,server/scripts/*.ps1,server/LOCAUS-PC.exe}",
      "excludeFiles": "client/dist/**"
    }
  },

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  "cleanUrls": true,
  "trailingSlash": false
}
